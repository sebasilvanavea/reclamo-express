# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor: nunca exponer al cliente. Lo usa la función programada de recordatorios.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública del sitio (para los enlaces de login y del correo)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo (Resend). Si no está configurado, la app igual funciona: muestra la carta para copiar.
RESEND_API_KEY=re_...
EMAIL_FROM="Reclamo Express <reclamos@tudominio.cl>"
