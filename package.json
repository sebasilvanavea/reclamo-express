{
  "name": "reclamo-express",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prueba:motor": "tsx scripts/prueba-motor.ts",
    "prueba:pdf": "esbuild scripts/prueba-pdf.tsx --bundle --platform=node --format=cjs --jsx=automatic --alias:@=. --external:@react-pdf/renderer --outfile=scripts/salida/prueba-pdf.cjs --log-level=warning && node scripts/salida/prueba-pdf.cjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@netlify/functions": "^3.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
